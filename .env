# Server Config
SERVER_PORT=8080

# NATS Config
# Важно: используем имена сервисов из docker-compose
NATS_URL=nats://nats:4222
NATS_STREAM_NAME=METRICS
NATS_SUBJECT=metrics.*
NATS_CONSUMER_GROUP=ingestion-worker-group

# ClickHouse Config
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=qwerty123